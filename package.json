{
  "name": "reto-swapi-mongodb-2026",
  "version": "0.0.1",
  "description": "Star Wars films API built with NestJS and JavaScript",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "node scripts/build.js",
    "format": "prettier --write \"src/**/*.js\" \"test/**/*.js\" \"scripts/**/*.js\"",
    "start": "node src/main.js",
    "start:dev": "node --watch src/main.js",
    "start:prod": "node dist/main.js",
    "test": "npm run build && jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "npm run build && jest --coverage --runInBand",
    "test:e2e": "npm test"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/platform-express": "^11.0.1",
    "joi": "^18.3.0",
    "mongoose": "^9.11.2",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "serverless-mysql": "^2.1.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.1",
    "jest": "^30.5.2",
    "prettier": "^3.0.0",
    "supertest": "^7.0.0"
  }
}
